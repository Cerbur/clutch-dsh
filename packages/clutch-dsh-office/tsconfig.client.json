{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/dsh-api-session-controller": [
        "node_modules/@deepseek-ai/dsh-api-session-controller/lib/types/index.d.ts"
      ],
      "@deepseek-ai/cordis": ["node_modules/@deepseek-ai/cordis/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-slots": [
        "node_modules/@deepseek-ai/dsh-client-ui-slots/lib/types/index.d.ts"
      ]
    }
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx", "src/office/**/*.ts"]
}
