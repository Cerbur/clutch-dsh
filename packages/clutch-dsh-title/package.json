{
  "name": "@cerbur/clutch-dsh-title",
  "version": "0.1.2",
  "description": "Configurable deterministic session titles for DeepSeek Harness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cerbur/clutch-dsh.git",
    "directory": "packages/clutch-dsh-title"
  },
  "homepage": "https://github.com/Cerbur/clutch-dsh/tree/main/packages/clutch-dsh-title",
  "packageManager": "pnpm@10.32.1",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session-title",
    "template"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "import": "./lib/types.js",
      "default": "./lib/types.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/client/entry.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsc -p tsconfig.json && node scripts/generate-typert.mjs && node scripts/build-client.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "clutchDsh": {
    "plugin": "@cerbur/clutch-dsh-title",
    "role": "plugin",
    "serviceDefinition": "@cerbur/clutch-dsh-title"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.2-rc.1",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-session": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-session-title": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-session-title-llm": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-timeout": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-util-values": ">=0.1.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-settings-controller": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-gateway": "0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-settings-file": "0.1.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-generator": "0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-loader": "0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "0.22.2",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-title": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-title-first-prompt-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-title-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-timeout": "0.1.2-rc.1",
    "@deepseek-ai/dsh-util-values": "0.1.2-rc.1",
    "@types/node": "^22.15.3",
    "js-yaml": "^4.1.0",
    "typescript": "^5.9.3"
  }
}
